{
  "name": "main-character-casting",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "import:questions": "python -X utf8 scripts/import_questions.py",
    "render:videos": "python -X utf8 scripts/render_videos.py",
    "media:sync": "node scripts/sync_media.mjs",
    "export:worlds": "node scripts/export_worlds.mjs",
    "render:cinema": "node scripts/export_worlds.mjs --raster && python -X utf8 scripts/render_cinema.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.3.5"
  }
}
