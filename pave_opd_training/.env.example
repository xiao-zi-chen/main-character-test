# Copy this file to .env on the server and fill values there.
# Never commit a real API key.

# Provider-specific API key for offline teacher labeling/scoring.
PAVE_TEACHER_API_KEY=

# Optional API base URL if using an OpenAI-compatible provider.
PAVE_TEACHER_API_BASE=

# Optional model name used by your teacher-labeling script.
PAVE_TEACHER_MODEL=

# Hugging Face token, only needed for gated models/datasets.
HF_TOKEN=

